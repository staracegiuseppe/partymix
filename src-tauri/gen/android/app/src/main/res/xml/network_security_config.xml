<?xml version="1.0" encoding="utf-8"?>
<!-- The app is served by its own local server (http://localhost:9527): the YouTube player needs a real http origin.
     Plain http is also needed for the PartyMix server on the home NAS (e.g. http://192.168.1.87:8788): Android cannot
     list address ranges here, so the app itself refuses plain http towards anything that is not a home/VPN address
     (isPrivateHost in src/sync/client.ts). Everything else on the internet is https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
