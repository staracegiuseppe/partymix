{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PartyMix",
  "version": "1.9.2",
  "identifier": "it.partymix.ai",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$AUDIO/PartyMix Library/**", "$APPDATA/PartyMix Library/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "DJ virtuale automatico per le feste",
    "windows": {
      "nsis": {
        "languages": [
          "Italian"
        ]
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libasound2",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "alsa-lib",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free"
        ]
      }
    }
  }
}
