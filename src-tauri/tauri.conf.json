{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PartyMix",
  "version": "1.6.0",
  "identifier": "it.partymix.ai",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "DJ virtuale automatico per le feste",
    "windows": {
      "nsis": {
        "languages": [
          "Italian"
        ]
      }
    }
  }
}